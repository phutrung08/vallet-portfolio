VALLET_APP_NAME=Vallet
# Defaults to "production" (fail-closed) when unset; dev defaults are refused outside development.
VALLET_ENVIRONMENT=development
VALLET_DATABASE_URL=postgresql+asyncpg://vallet:vallet_dev@127.0.0.1:5433/vallet
# Set true on serverless runtimes (e.g. Vercel) to use NullPool and disable prepared statement caches.
VALLET_DB_NULL_POOL=false
VALLET_TEST_DATABASE_URL=postgresql+asyncpg://vallet:vallet_dev@127.0.0.1:5433/vallet_test
# Only for local development over plain HTTP; production requires true (default).
VALLET_COOKIE_SECURE=false
VALLET_DEVICE_TTL_DAYS=180
# Derives every trip's share link. Required (32+ random bytes) outside development.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
VALLET_SHARE_LINK_KEY=dev-only-share-link-key-not-for-production-use-0000
# AES-256-GCM key for bank account numbers: 32 random bytes, base64url. Required outside development.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
VALLET_BANK_DATA_KEY=ZGV2LW9ubHktYmFuay1rZXktbm90LWZvci1wcm9kISE
# JSON list of origins allowed to send state-changing requests (exact scheme, host, and port).
VALLET_ALLOWED_ORIGINS=["http://localhost:5173"]
# Set true only behind a reverse proxy that appends client IPs to X-Forwarded-For.
VALLET_TRUST_PROXY_HEADERS=false
# Run uvicorn with --no-access-log in production so query strings are never logged.
